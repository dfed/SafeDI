    "changed: let X1 {+ = if let safeDIBuilder = safeDIOverrides { safeDIBuilder ( X2 . instance ) } else { X3 ( X2 +} : X3 … X1 : {- X3 = __safeDI_X1 ( -}{+ X2 . instance +} ) … ( ) {+ } +}",
    "function removed: func __safeDI_X1 ( ) -> X2 {"
   ],
   "scope": "mock"
  },
  {
   "id": "not-approved-binding-type-changes",
   "ruling": "Not approved, whatever the kind",
   "summary": "A binding's declared type changes: optional for non-optional, some for any.",
   "shapes": [
