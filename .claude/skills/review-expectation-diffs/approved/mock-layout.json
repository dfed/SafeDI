   "shapes": [
    "changed: let X1 {+ : X2 +} = if",
    "changed: let X1 {+ : X2 . X3 +} = if"
   ],
   "scope": "mock"
  },
  {
   "id": "10-public-mock-guard-once-in-root",
   "ruling": "lead 11-27 9:31 AM PT",
   "summary": "A public mock's guard line sits once, in the root's body.",
   "shapes": [
    "moved: _ = X1 . __safeDI_X2 . self //…",
    "removed: _ = X1 . __safeDI_X2 . self //…"
   ],
   "scope": "mock"
  },
  {
   "id": "11-function-named-apart",
   "ruling": "lead 11-27 9:31 AM PT",
