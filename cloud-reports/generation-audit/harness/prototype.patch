+	/// AUDIT PROTOTYPE: `code.split(separator: "\n").map { whitespace + $0 }.joined(separator: "\n")`, in one pass over UTF-8.
+	static func indenting(_ code: String, by whitespace: String) -> String {
+		var result = [UInt8]()
+		let indent = Array(whitespace.utf8)
+		var utf8 = code.utf8
+		result.reserveCapacity(utf8.count + utf8.count / 8)
+		var atLineStart = true
+		var wroteLine = false
+		for byte in utf8 {
+			if byte == 10 {
+				atLineStart = true
+			} else {
+				if atLineStart {
+					if wroteLine { result.append(10) }
+					result.append(contentsOf: indent)
+					atLineStart = false
+					wroteLine = true
+				}
+				result.append(byte)
+			}
+		}
+		_ = utf8
+		return String(decoding: result, as: UTF8.self)
+	}
+
+	/// AUDIT PROTOTYPE: `path.replacingOccurrences(of: "safeDIOverrides.", with: "").replacingOccurrences(of: ".", with: "_")`.
+	static func overrideRelativePath(_ path: String) -> String {
+		var bytes = Array(path.utf8)
+		let prefix = Array("\(ReservedName.mockOverridesParameterName).".utf8)
+		var output = [UInt8]()
+		output.reserveCapacity(bytes.count)
+		var index = 0
+		while index < bytes.count {
+			if bytes[index] == prefix[0], index + prefix.count <= bytes.count, bytes[index..<(index + prefix.count)].elementsEqual(prefix) {
+				index += prefix.count
+			} else {
+				output.append(bytes[index] == 46 ? 95 : bytes[index])
+				index += 1
+			}
 		}
+		bytes = []
+		return String(decoding: output, as: UTF8.self)
 	}
 
