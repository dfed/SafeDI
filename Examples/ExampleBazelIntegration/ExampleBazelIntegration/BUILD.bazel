load("@safedi//bazel:safedi.bzl", "safedi_swift_library")

# `safedi_swift_library` declares `ExampleBazelIntegration`, a
# `swift_library`, and `ExampleBazelIntegration_safedi`, which runs
# SafeDITool over the same sources with the same `defines` and `copts`.
# The generated `ExampleBazelIntegration_safedi.swift` holds the
# dependency tree and every mock the module needs, in one declared
# output regardless of source contents.
safedi_swift_library(
    name = "ExampleBazelIntegration",
    srcs = glob(["**/*.swift"]),
    # Treating warnings as errors makes CI fail on a warning in SafeDI's
    # generated code, such as a `#sourceLocation` directive whose path
    # conflicts with the one the compiler was handed.
    copts = ["-warnings-as-errors"],
    module_name = "ExampleBazelIntegration",
    # The package `Subproject` and `Models` belong to, so the code SafeDI
    # generates here may call `package` initializers it generates there.
    package_name = "ExampleBazelIntegration",
    # This module declares the root, so it lists every module beneath it:
    # the root's tree can build a type any of them declares, and this
    # module is rebuilt whenever one of them changes anyway.
    safedi_deps = [
        "//Models:Models_safedi",
        "//Subproject:Subproject_safedi",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//Models",
        "//Subproject:Subproject",
        "@safedi//:SafeDI",
    ],
)
