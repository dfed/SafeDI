load("@rules_swift//swift:swift.bzl", "swift_library")
load("@safedi//bazel:safedi.bzl", "safedi_module_info")

# `.safedi` module-info artifact published for downstream consumers.
# Contains the subproject's @Instantiable surface in JSON so the host
# target can resolve cross-module types without re-parsing these
# sources.
safedi_module_info(
    name = "Subproject_safedi",
    srcs = glob(["*.swift"]),
    visibility = ["//ExampleBazelIntegration:__pkg__"],
)

swift_library(
    name = "Subproject",
    srcs = glob(["*.swift"]),
    module_name = "Subproject",
    visibility = ["//ExampleBazelIntegration:__pkg__"],
    deps = [
        "@safedi//Sources/SafeDI",
    ],
)
