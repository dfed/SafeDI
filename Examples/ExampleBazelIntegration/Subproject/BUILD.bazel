load("@safedi//bazel:safedi.bzl", "safedi_swift_library")

# `safedi_swift_library` declares `Subproject`, a `swift_library`, and
# `Subproject_safedi`, which runs SafeDITool over the same sources. The
# host target reaches this module's `.safedi` module-info artifact via
# `"//Subproject:Subproject_safedi"` in its `safedi_deps`.
#
# `Subproject` and `Models` belong to one package, `package_name`, so
# `Subproject` can name `Models`' `package` types, and lists
# `Models_safedi`, since it imports `Models`: see `Models/BUILD.bazel`.
safedi_swift_library(
    name = "Subproject",
    srcs = glob(["*.swift"]),
    module_name = "Subproject",
    package_name = "ExampleBazelIntegration",
    safedi_deps = [
        "//Models:Models_safedi",
    ],
    visibility = ["//ExampleBazelIntegration:__pkg__"],
    deps = [
        "//Models",
        "@safedi//:SafeDI",
    ],
)
