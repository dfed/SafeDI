load("@rules_swift//swift:swift.bzl", "swift_library")
load("@safedi//bazel:safedi.bzl", "safedi_compile")

# `safedi_compile` emits both the `.safedi` module-info artifact for
# cross-module consumers and the combined `.swift` source the
# subproject compiles against. The host target reaches the
# `.safedi` via `dependents = ["//Subproject:Subproject_safedi"]`.
safedi_compile(
    name = "Subproject_safedi",
    srcs = glob(["*.swift"]),
    visibility = ["//ExampleBazelIntegration:__pkg__"],
)

swift_library(
    name = "Subproject",
    srcs = glob(["*.swift"]) + [":Subproject_safedi"],
    module_name = "Subproject",
    visibility = ["//ExampleBazelIntegration:__pkg__"],
    deps = [
        "@safedi//Sources/SafeDI",
    ],
)
