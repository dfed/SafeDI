"""Bazel module for the SafeDI Tuist-parity example, ARM-mac-only."""

module(
    name = "example_bazel_integration",
    version = "0.1.0",
)

bazel_dep(name = "rules_swift", version = "3.6.0")
bazel_dep(name = "rules_apple", version = "4.3.3")
bazel_dep(name = "apple_support", version = "1.24.2")
bazel_dep(name = "rules_swift_package_manager", version = "1.15.0")

# Pull the SafeDI runtime library into Bazel via
# rules_swift_package_manager. `@swiftpkg_safedi//:SafeDI` is the
# library + macro entry point.
swift_deps = use_extension(
    "@rules_swift_package_manager//:extensions.bzl",
    "swift_deps",
)
swift_deps.from_package(
    resolved = "//:Package.resolved",
    swift = "//:Package.swift",
)
use_repo(
    swift_deps,
    "swift_package",
    "swiftpkg_safedi",
)

# Download the prebuilt SafeDITool CLI.
safeditool = use_extension("//bazel:safeditool_extension.bzl", "safeditool")
use_repo(safeditool, "safeditool_bundle")
