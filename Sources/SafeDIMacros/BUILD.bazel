load("@build_bazel_rules_swift//swift:swift.bzl", "swift_compiler_plugin")

# SafeDIMacros inlines SafeDICore's sources into the same module (SPM
# does this via a Sources/SafeDIMacros/SafeDICore symlink; Bazel's glob
# doesn't follow symlinked dirs, so we pull them in explicitly via the
# `SafeDICoreSources` filegroup, which leaves out the sources only
# SafeDITool uses).
swift_compiler_plugin(
    name = "SafeDIMacros",
    srcs = glob(["**/*.swift"]) + ["//Sources/SafeDICore:SafeDICoreSources"],
    module_name = "SafeDIMacros",
    visibility = ["//visibility:public"],
    deps = [
        "@swift-syntax//:SwiftCompilerPlugin",
        "@swift-syntax//:SwiftDiagnostics",
        "@swift-syntax//:SwiftParser",
        "@swift-syntax//:SwiftSyntax",
        "@swift-syntax//:SwiftSyntaxBuilder",
        "@swift-syntax//:SwiftSyntaxMacros",
    ],
)
