load("@build_bazel_rules_swift//swift:swift.bzl", "swift_binary")

swift_binary(
    name = "SafeDITool",
    srcs = glob(["**/*.swift"]),
    # The module name SwiftPM gives the executable, so that both builds
    # name every module of the tool alike.
    module_name = "SafeDITool",
    visibility = ["//visibility:public"],
    deps = [
        "//Sources/SafeDIToolLibrary",
        "@swift_argument_parser//:ArgumentParser",
    ],
)
