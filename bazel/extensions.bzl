"""The `safeditool` module extension, which SafeDI's own `MODULE.bazel` uses.

It declares the toolchains that hand `safedi_compile` a prebuilt
SafeDITool: an `http_file` repository for each binary the SafeDI release
uploads, and the `safeditool_toolchains` repository, which declares a
`toolchain()` for each binary on the execution platform it runs on.
`MODULE.bazel` registers those toolchains ahead of
`//bazel:safeditool_from_source_toolchain`, which builds SafeDITool from
this source tree and runs on any execution platform. Bazel downloads a
binary only when its toolchain is selected.

## Which SafeDITool a build runs

`bazel/private/prebuilt_safeditool.bzl` names the binaries and their
sha256. The repository keeps that file empty on every commit, and the
`Bazel Source Archive Check` CI job fails when it is not. The publish
workflow fills it in only inside `SafeDI-<version>.tar.gz`, the source
archive the Bazel Central Registry entry for `<version>` points at
(`Scripts/create-bazel-source-archive.sh`).

Guarantee: the rule and the SafeDITool it runs come from the same
source. An empty file makes this extension declare no prebuilt
toolchain, so the only toolchain left is
`//bazel:safeditool_from_source_toolchain`, whatever
`--@safedi//bazel:prefer_prebuilt_safeditool` says. A build of any
checkout of the repository (a `local_path_override`, a `git_override`,
or an `archive_override` of a GitHub archive) therefore runs SafeDITool
built from that checkout, and never an older release's binary that may
not accept the options the checkout's rule passes. The sha256 values
exist only in a release's source archive, where the rule and the binaries
are the same release.

  - A build of a SafeDI release from the registry runs that release's
    binary for the execution platform (macOS arm64 or x86_64, Linux
    x86_64 or arm64). It builds SafeDITool from source when
    `--@safedi//bazel:prefer_prebuilt_safeditool=false` is set or no
    binary runs on the execution platform.
  - A build of a checkout builds SafeDITool from that checkout.
"""

load("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")
load("//bazel/private:prebuilt_safeditool.bzl", "SAFEDITOOL_RELEASE", "SAFEDITOOL_SHA256")

# The execution platform each binary runs on, keyed by the `<platform>` of
# its `SafeDITool-<platform>` release asset.
_EXECUTION_PLATFORM_CONSTRAINTS = {
    "linux-arm64": [Label("@platforms//os:linux"), Label("@platforms//cpu:aarch64")],
    "linux-x86_64": [Label("@platforms//os:linux"), Label("@platforms//cpu:x86_64")],
    "macos-arm64": [Label("@platforms//os:macos"), Label("@platforms//cpu:aarch64")],
    "macos-x86_64": [Label("@platforms//os:macos"), Label("@platforms//cpu:x86_64")],
}

_SAFEDITOOL_TOOLCHAIN_BZL = Label("//bazel/private:safeditool_toolchain.bzl")
_SAFEDITOOL_TOOLCHAIN_TYPE = Label("//bazel:safeditool_toolchain_type")
_PREFER_PREBUILT_SAFEDITOOL = Label("//bazel:prefer_prebuilt_safeditool_set")

def _safeditool_toolchains_impl(repository_ctx):
    repository_ctx.file("BUILD.bazel", repository_ctx.attr.build_file_content)

_safeditool_toolchains = repository_rule(
    implementation = _safeditool_toolchains_impl,
    attrs = {
        "build_file_content": attr.string(mandatory = True),
    },
)

def _prebuilt_toolchain_declaration(platform):
    name = platform.replace("-", "_")
    return """
toolchain(
    name = "{name}_toolchain",
    exec_compatible_with = {exec_compatible_with},
    target_settings = ["{prefer_prebuilt_safeditool}"],
    toolchain = ":{name}",
    toolchain_type = "{toolchain_type}",
)

safeditool_toolchain(
    name = "{name}",
    safeditool = "@safeditool_{name}//file",
)
""".format(
        name = name,
        exec_compatible_with = repr([str(constraint) for constraint in _EXECUTION_PLATFORM_CONSTRAINTS[platform]]),
        prefer_prebuilt_safeditool = str(_PREFER_PREBUILT_SAFEDITOOL),
        toolchain_type = str(_SAFEDITOOL_TOOLCHAIN_TYPE),
    )

def _safeditool_impl(module_ctx):
    build_file_content = [
        "# Generated by SafeDI's `safeditool` module extension (//bazel:extensions.bzl).",
        "# One toolchain per prebuilt SafeDITool, none when the source tree names none.",
        "",
        "load(\"{}\", \"safeditool_toolchain\")".format(str(_SAFEDITOOL_TOOLCHAIN_BZL)),
    ]
    if SAFEDITOOL_SHA256 and not SAFEDITOOL_RELEASE:
        fail("bazel/private/prebuilt_safeditool.bzl names SafeDITool binaries but no release to download them from.")
    for platform in sorted(SAFEDITOOL_SHA256.keys()):
        if platform not in _EXECUTION_PLATFORM_CONSTRAINTS:
            fail("bazel/private/prebuilt_safeditool.bzl names a SafeDITool for '{}', which runs on no execution platform this extension knows.".format(platform))
        http_file(
            name = "safeditool_" + platform.replace("-", "_"),
            urls = ["https://github.com/dfed/SafeDI/releases/download/{}/SafeDITool-{}".format(SAFEDITOOL_RELEASE, platform)],
            sha256 = SAFEDITOOL_SHA256[platform],
            executable = True,
            downloaded_file_path = "SafeDITool",
        )
        build_file_content.append(_prebuilt_toolchain_declaration(platform))
    _safeditool_toolchains(
        name = "safeditool_toolchains",
        build_file_content = "\n".join(build_file_content),
    )
    return module_ctx.extension_metadata(reproducible = True)

safeditool = module_extension(
    implementation = _safeditool_impl,
    doc = "Declares a toolchain for each prebuilt SafeDITool `bazel/private/prebuilt_safeditool.bzl` names. See this file's documentation.",
)
