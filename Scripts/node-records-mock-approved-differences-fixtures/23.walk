    struct SafeDIMockConfiguration {
        init(
            h2: H2.SafeDIMockConfiguration = .init(),
            _ safeDIBuilder: ((Service, H2) -> P0)? = nil
        ) {
            __safeDI_storage = __safeDI_Storage(
